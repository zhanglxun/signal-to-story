# Browser-safe values only: Project URL and publishable key. Never put service_role / secret keys here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Site title / description shown in the header (optional).
VITE_SITE_NAME=
VITE_SITE_DESCRIPTION=
# Optional: only show published documents of this organization id.
VITE_SITE_ORGANIZATION_ID=
# 1 = local demo mode with built-in sample snapshots (also enabled automatically when Supabase is not configured).
VITE_SITE_DEMO=
