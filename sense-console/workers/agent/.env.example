# Agent Harness worker — process environment only. Never put these in VITE_* or browser code.
# The worker does NOT read sense-console/.env.local.

# Supabase (service_role: worker only; agents/CLIs never see it — child processes get an env allowlist)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Worker identity and queue tuning
SENSE_WORKER_ID=
SENSE_WORKER_JOB_TYPES=content_draft
SENSE_WORKER_LEASE_SECONDS=120
SENSE_WORKER_POLL_MS=5000

# Generator model. DRIVER=cloud (OpenAI-compatible) or cli (codex-cli only, verified)
SENSE_LLM_DRIVER=cloud
SENSE_LLM_PROVIDER=qwen
SENSE_LLM_BASE_URL=
SENSE_LLM_API_KEY=
SENSE_LLM_MODEL=
SENSE_LLM_TIMEOUT_MS=90000
SENSE_LLM_INPUT_CENTS_PER_1K=
SENSE_LLM_OUTPUT_CENTS_PER_1K=
# SENSE_LLM_CLI=codex-cli
# SENSE_LLM_CLI_BINARY=

# Independent evaluator model (recommended: different vendor/model from the generator).
# Falls back to the generator settings when no SENSE_EVAL_LLM_* variable is set.
SENSE_EVAL_LLM_DRIVER=cloud
SENSE_EVAL_LLM_PROVIDER=deepseek
SENSE_EVAL_LLM_BASE_URL=
SENSE_EVAL_LLM_API_KEY=
SENSE_EVAL_LLM_MODEL=
