{
  "name": "signal-to-story",
  "private": true,
  "description": "Runtime side of Signal to Story: workers, Supabase tests and shared test infrastructure. Web apps live in sense-console/ and sense-site/ with their own package.json.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:video-worker": "python3 -m unittest discover -s workers/video/tests -t workers/video",
    "worker:agent": "tsx workers/agent/main.ts",
    "demo:harness": "tsx workers/agent/demo/demo-harness.ts",
    "demo:capture": "tsx workers/agent/demo/demo-capture.ts",
    "demo:video": "tsx workers/agent/demo/demo-video-studio.ts",
    "audit:schema": "tsx testing/db/schema-audit/build.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint/js": "^9.36.0",
    "@types/node": "^22.18.6",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8",
    "vitest": "^3.2.4"
  }
}
